NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=your-supabase-publishable-key
NEXT_PUBLIC_SITE_URL=http://localhost:3000
ENFORCE_SUBSCRIPTIONS=false

# Optional Innova AI assistant (private, server-side only)
OPENAI_API_KEY=
OPENAI_MODEL=gpt-6-luna

# Optional Stripe subscriptions (private, server-side only)
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_PRICE_ID_STARTER=
STRIPE_PRICE_ID_GROWTH=
STRIPE_PRICE_ID_MULTI_PROPERTY=

# Supabase service key is used only by the signed Stripe webhook route.
SUPABASE_SERVICE_ROLE_KEY=
